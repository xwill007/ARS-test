# Configuración del servidor de desarrollo
VITE_FRONT_IP=localhost
VITE_PORT=3000
VITE_HTTPS=true

# Configuración del navegador (chrome, firefox, edge, msedge)
DEFAULT_BROWSER=chrome

# Rutas de navegadores (ajustar según la instalación local)
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
FIREFOX_PATH=C:\Program Files\Mozilla Firefox\firefox.exe
EDGE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe

# Configuración de Node.js
NODE_PATH=
NPM_REGISTRY=https://registry.npmjs.org/

# Configuración SSL
SSL_COUNTRY=CO
SSL_STATE=Antioquia
SSL_CITY=Medellin
SSL_ORGANIZATION=Desarrollo
SSL_COMMON_NAME=localhost

# Configuración de instalación
SKIP_OPTIONAL_DEPS=true
SKIP_AUDIT=true
SKIP_FUND=true
LOG_LEVEL=error

# Configuración de OpenSSL (ajustar según la instalación local)
OPENSSL_PATH=C:\Program Files\Git\usr\bin\openssl.exe

# Configuración de certificados
CERT_DAYS=365
CERT_KEY_SIZE=4096

# Configuración de desarrollo
AUTO_OPEN_BROWSER=true
CLEAR_SCREEN=false
IGNORE_CERT_ERRORS=true

# Configuración de cache
FORCE_CLEAN_CACHE=false
FORCE_REINSTALL=false