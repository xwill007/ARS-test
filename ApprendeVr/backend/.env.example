PORT=3001

DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASS=
DB_NAME=english_vr

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Origin del frontend Vite en desarrollo (VITE_FRONT_IP:VITE_PORT). Si se omite, CORS refleja el
# origin de la petición (cómodo en desarrollo local, no usar así en producción).
CORS_ORIGIN=https://localhost:3000

# URL base del servicio LibreTranslate self-hosted (Requerimiento 015, traducción de la letra).
# Se levanta con `docker compose up -d translate` (ver docker-compose.yml, servicio `translate`).
# Puerto 5001: macOS usa el 5000 para AirPlay Receiver.
LIBRETRANSLATE_URL=http://localhost:5001
